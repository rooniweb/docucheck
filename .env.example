# ─── Modèle LLM ───────────────────────────────────────────────────────────────
# Modèle par défaut via LiteLLM (Ollama local)
LLM_MODEL=ollama/mistral

# Clé OpenAI — laisser vide pour rester 100 % local
OPENAI_API_KEY=

# ─── Services internes ────────────────────────────────────────────────────────
LITELLM_BASE_URL=http://litellm:4000
LITELLM_API_KEY=sk-docucheck
DOCLING_BASE_URL=http://docling:5001

# ─── Base de données ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://docucheck:docucheck@postgres:5432/docucheck

# ─── Décision ─────────────────────────────────────────────────────────────────
# Score de confiance minimum (en dessous → revue humaine)
CONFIDENCE_THRESHOLD=0.80

# ─── n8n ──────────────────────────────────────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=changeme

# ─── Logs ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
